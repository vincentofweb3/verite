rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.owner_id;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.owner_id;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.owner_id &&
        request.resource.data.owner_id == resource.data.owner_id;
      match /scripts/{scriptId}/scenes/{sceneId} {
        allow read, write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.owner_id;
      }
    }
  }
}
